  "metadata": {
    "owner": "Safe{Wallet}",
    "contractName": "Safe"
  },
  "display": {
    "formats": {
      "setup(address[] _owners, uint256 _threshold, address to, bytes data, address fallbackHandler, address paymentToken, uint256 payment, address paymentReceiver)": {
        "intent": "Set up Safe",
        "fields": [
          {
            "path": "_owners.[]",
            "label": "Owner",
            "format": "addressName"
          },
          {
            "path": "_threshold",
            "label": "Signatures required",
            "format": "raw"
          },
          {
            "path": "to",
            "label": "Setup call target",
            "visible": {
              "mustMatch": [
                "0x0000000000000000000000000000000000000000"
              ]
            }
          },
          {
            "path": "data",
            "label": "Setup call data",
            "visible": {
              "mustMatch": [
                "0x"
              ]
            }
          },
          {
            "path": "fallbackHandler",
            "label": "Fallback handler",
            "visible": {
              "mustMatch": [
                "0x0000000000000000000000000000000000000000",
                "0xf48f2b2d2a534e402487b3ee7c18c33aec0fe5e4",
                "0x017062a1de2fe6b99be3d9d37841fed19f573804",
                "0xfd0732dc9e303f09fcef3a7388ad10a83459ec99",
                "0x3efcbb83a4a7afcb4f68d501e2c2203a38be77f4"
              ]
            }
          },
          {
            "path": "paymentToken",
            "label": "Payment token",
            "visible": {
              "mustMatch": [
                "0x0000000000000000000000000000000000000000"
              ]
            }
          },
          {
            "path": "payment",
            "label": "Payment",
            "visible": {
              "mustMatch": [
                "0"
              ]
            }
          },
          {
            "path": "paymentReceiver",
            "label": "Payment receiver",
            "visible": {
              "mustMatch": [
                "0x0000000000000000000000000000000000000000"
              ]
            }
          }
        ]
      },
      "execTransaction(address to, uint256 value, bytes data, uint8 operation, uint256 safeTxGas, uint256 baseGas, uint256 gasPrice, address gasToken, address refundReceiver, bytes signatures)": {
        "intent": "Execute Safe transaction",
        "fields": [
          {
            "path": "to",
            "label": "Safe calls",
            "format": "addressName"
          },
          {
            "path": "value",
            "label": "Safe sends",
            "format": "amount"
          },
          {
            "path": "data",
            "label": "Safe transaction",
            "format": "calldata",
            "params": {
              "calleePath": "to",
              "amountPath": "value"
            }
          },
          {
            "path": "operation",
            "label": "Operation",
            "visible": {
              "mustMatch": [
                "0"
              ]
            }
          },
          {
            "path": "safeTxGas",
            "label": "Safe gas limit",
            "format": "raw"
          },
          {
            "path": "baseGas",
            "label": "Base gas",
            "format": "raw"
          },
          {
            "path": "gasPrice",
            "label": "Refund gas price",
            "visible": {
              "mustMatch": [
                "0"
              ]
            }
          },
          {
            "path": "gasToken",
            "label": "Refund token",
            "visible": {
              "mustMatch": [
                "0x0000000000000000000000000000000000000000"
              ]
            }
          },
          {
            "path": "refundReceiver",
            "label": "Refund receiver",
            "visible": {
              "mustMatch": [
                "0x0000000000000000000000000000000000000000"
              ]
            }
          },
          {
            "path": "signatures",
            "label": "Owner signatures (not checked by Bloom)",
            "format": "raw"
          }
        ]
      },
      "addOwnerWithThreshold(address owner, uint256 _threshold)": {
        "intent": "Add Safe owner",
        "fields": [
          {
            "path": "owner",
            "label": "New owner",
            "format": "addressName"
          },
          {
            "path": "_threshold",
            "label": "Signatures required",
            "format": "raw"
          }
        ]
      },
      "removeOwner(address prevOwner, address owner, uint256 _threshold)": {
        "intent": "Remove Safe owner",
        "fields": [
          {
            "path": "prevOwner",
            "label": "Owner before it in the list",
            "format": "addressName"
          },
          {
            "path": "owner",
            "label": "Removed owner",
            "format": "addressName"
          },
          {
            "path": "_threshold",
            "label": "Signatures required",
            "format": "raw"
          }
        ]
      },
      "swapOwner(address prevOwner, address oldOwner, address newOwner)": {
        "intent": "Replace Safe owner",
        "fields": [
          {
            "path": "prevOwner",
            "label": "Owner before it in the list",
            "format": "addressName"
          },
          {
            "path": "oldOwner",
            "label": "Removed owner",
            "format": "addressName"
          },
          {
            "path": "newOwner",
            "label": "New owner",
            "format": "addressName"
          }
        ]
      },
      "changeThreshold(uint256 _threshold)": {
        "intent": "Change Safe threshold",
        "fields": [
          {
            "path": "_threshold",
            "label": "Signatures required",
            "format": "raw"
          }
        ]
      }
    }
  }
